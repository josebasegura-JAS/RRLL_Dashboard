{
  "name": "cuadro-mando-rrll-db",
  "version": "1.8.0",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rrll.cuadromandodb",
    "productName": "Cuadro de Mando RRLL",
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "app/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cuadro-de-Mando-RRLL-1.8.0.exe",
      "icon": "app/assets/icon.ico"
    },
    "artifactName": "Cuadro-de-Mando-RRLL-1.8.0.exe"
  },
  "dependencies": {
    "sql.js": "^1.10.3",
    "adm-zip": "^0.5.16",
    "@kenjiuno/msgreader": "^1.15.0"
  },
  "description": "Cuadro de Mando RRLL - v1.8.0 estable BBDD Especiales",
  "author": "Relaciones Laborales"
}
